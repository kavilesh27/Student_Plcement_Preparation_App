PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/placement_portal
JWT_SECRET=
JWT_EXPIRE=7d

# Optional AI Integration (Gemini API or OpenAI compatible)
# If empty, the system uses the built-in Intelligent Offline NLP Resume & Question Generator
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash

# Optional Code Execution Service (Piston / Judge0)
# If empty, the system runs in Transparent Sandbox Mock Evaluation Mode
CODE_EXECUTION_API_URL=
CODE_EXECUTION_API_KEY=

# File Upload Settings
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads
